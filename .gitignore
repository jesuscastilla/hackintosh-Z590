# ========================================================
# Hackintosh Git Ignore
# Exclude sensitive data, private credentials, and large binaries
# ========================================================

# --- Private / Sensitive Data (iServices & Local Machine) ---
Active_EFI_Backup/
Temp_Restore/
EFI_Backup_*/
ESP_Backup_*/
EFI/OC/*.bak*
*.vars
vars/
.DS_Store
Thumbs.db
desktop.ini

# --- Local config with real SMBIOS credentials (NEVER commit) ---
config.local.plist
smbios.env

# --- Workspace, IDE & Local Rules Configuration ---
.agents/
.vscode/
.idea/
.cursor/
.cursorrules
.windsurf/
.windsurfrules
.cline/
.clinerules/
.clinerules.md
.clinerules
.roo/
.roorules
.claude/
.gemini/
.ai/
rules.md
RULES.md
reglas.md
REGLAS.md
REGLAS-*.md
REGLAS_*.md
context.md
CONTEXT.md
CONTEXT-*.md
CONTEXT_*.md
._CONTEXT.md
AGENTS.md
agents.md
CLAUDE.md
claude.md
GEMINI.md
gemini.md
prompts/
*.prompts.xml
copilot-instructions.md
.github/copilot-instructions.md

# --- Large OS Installers & Packages (>100MB GitHub limit) ---
SonomaInstaller/
Assets/
Assets.pkg
AutoPkg.pkg
*.pkg
*.dmg
*.iso
*.zip
OCLP-src/
OpenCore/
Downloads/
oclp_temp/
itlwm_extract/
Kexts_Download/

# --- OpenCore & Boot Logs ---
opencore-*.txt
*.log

# --- Windows Boot & Machine Specific Files ---
BCD
BCD.*
*.p7b
bootmgfw_orig.efi

# --- Python Cache & Local Scratch Scripts ---
__pycache__/
*.pyc
*.pyo
*.pyd
scratch_*.py
